"""
PhenoSigDB Scaffold Generator

Generates folder structure and template parser for new signature curation.

Usage:
    python curation/tools/phenosigdb-scaffold <SourceKey> --domain <DOMAIN> [--author AUTHOR] [--doi DOI] [--year YEAR]

Examples:
    python curation/tools/phenosigdb-scaffold MyPaper24 --domain FIBROBLAST
    python curation/tools/phenosigdb-scaffold MyPaper24 --domain CELL --author "Smith.etal" --doi "10.1038/xyz123"

Generated structure:
    curation/input/<SourceKey>/
        build_curated.R    # Template R parser
        README.md          # Parser notes
"""

